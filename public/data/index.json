[{"id":"xinjing","title":"般若波罗蜜多心经","shortTitle":"心经","sanskrit":"Prajñāpāramitā Hṛdaya","dynasty":"唐","translator":"玄奘 奉诏译","era":"公元 649 年","desc":"六百卷《大般若经》之精髓，二百六十字涵摄五蕴皆空之理，是流传最广的佛经短章。","quote":"色不异空，空不异色；色即是空，空即是色。","accent":"#b3925f","chapters":[{"no":1,"title":"全一卷","note":"","paras":7,"translated":7}]},{"id":"jingang","title":"金刚般若波罗蜜经","shortTitle":"金刚经","sanskrit":"Vajracchedikā Prajñāpāramitā Sūtra","dynasty":"姚秦","translator":"鸠摩罗什 译","era":"公元 401 年前后","desc":"般若部之要典，三十二分层层破执，如金刚断一切妄，昭示「应无所住而生其心」之旨。","quote":"凡所有相，皆是虚妄。若见诸相非相，即见如来。","accent":"#8f9a7a","chapters":[{"no":1,"title":"法会因由分第一","note":"说法聚会，由此起因","paras":5,"translated":5},{"no":2,"title":"善现启请分第二","note":"善现长老，启请佛训","paras":7,"translated":7},{"no":3,"title":"大乘正宗分第三","note":"最大之乘，最正之宗","paras":5,"translated":5},{"no":4,"title":"妙行无住分第四","note":"奥妙之行，本无住着","paras":9,"translated":9},{"no":5,"title":"如理实见分第五","note":"自如之理，乃见真实","paras":3,"translated":3},{"no":6,"title":"正信希有分第六","note":"生正信心，最为希有","paras":11,"translated":11},{"no":7,"title":"无得无说分第七","note":"空则无得，寂则无说","paras":5,"translated":5},{"no":8,"title":"依法出生分第八","note":"诸佛之法，依此生出","paras":5,"translated":5},{"no":9,"title":"一相无相分第九","note":"只此一相，本来无形","paras":14,"translated":14},{"no":10,"title":"庄严净土分第十","note":"成就庄严，净明心地","paras":8,"translated":8},{"no":11,"title":"无为福胜分第十一","note":"修无为福，胜于布施","paras":7,"translated":7},{"no":12,"title":"尊重正教分第十二","note":"受持正教，天人尊重","paras":3,"translated":3},{"no":13,"title":"如法受持分第十三","note":"当如此法，承受奉持","paras":13,"translated":13},{"no":14,"title":"离相寂灭分第十四","note":"离诸形相，自得寂灭","paras":26,"translated":26},{"no":15,"title":"持经功德分第十五","note":"受持此经，功德无量","paras":15,"translated":15},{"no":16,"title":"能净业障分第十六","note":"若能清净，业障尽消","paras":10,"translated":10},{"no":17,"title":"究竟无我分第十七","note":"成佛究竟，本无我相","paras":25,"translated":25},{"no":18,"title":"一体同观分第十八","note":"万法归一，更无异观","paras":17,"translated":17},{"no":19,"title":"法界通化分第十九","note":"法身遍界，通化无边","paras":3,"translated":3},{"no":20,"title":"离色离相分第二十","note":"色相皆妄，离妄见性","paras":6,"translated":6},{"no":21,"title":"非说所说分第二十一","note":"法无可说，所说非法","paras":6,"translated":6},{"no":22,"title":"无法可得分第二十二","note":"悟性空故，无法可得","paras":3,"translated":3},{"no":23,"title":"净心行善分第二十三","note":"以清净心，行诸善法","paras":3,"translated":3},{"no":24,"title":"福智无比分第二十四","note":"福智甚大，无物可比","paras":3,"translated":3},{"no":25,"title":"化无所化分第二十五","note":"圣凡同性，化无所化","paras":4,"translated":4},{"no":26,"title":"法身非相分第二十六","note":"清净法身，非属相貌","paras":6,"translated":6},{"no":27,"title":"无断无灭分第二十七","note":"依法修持，不应断灭","paras":4,"translated":4},{"no":28,"title":"不受不贪分第二十八","note":"一尘不染，何贪何受","paras":5,"translated":5},{"no":29,"title":"威仪寂静分第二十九","note":"真性寂静，不假威仪","paras":2,"translated":2},{"no":30,"title":"一合理相分第三十","note":"一合之理，实无有相","paras":6,"translated":6},{"no":31,"title":"知见不生分第三十一","note":"如此知见，法相不生","paras":8,"translated":8},{"no":32,"title":"应化非真分第三十二","note":"应现设化，亦非真实","paras":6,"translated":6}]},{"id":"tanjing","title":"六祖大师法宝坛经","shortTitle":"坛经","sanskrit":"Liùzǔ Tánjīng","dynasty":"唐","translator":"六祖惠能 说 · 法海 记","era":"约公元 713 年","desc":"唯一被称为「经」的中国僧人著述，十品记曹溪法门，直指人心，见性成佛。","quote":"菩提自性，本来清净，但用此心，直了成佛。","accent":"#9a7f6b","chapters":[{"no":1,"title":"行由品第一","note":"","paras":95,"translated":95},{"no":2,"title":"般若品第二","note":"","paras":34,"translated":34},{"no":3,"title":"疑问品第三","note":"","paras":28,"translated":28},{"no":4,"title":"定慧品第四","note":"","paras":11,"translated":11},{"no":5,"title":"坐禅品第五","note":"","paras":11,"translated":11},{"no":6,"title":"忏悔品第六","note":"","paras":38,"translated":38},{"no":7,"title":"机缘品第七","note":"","paras":175,"translated":175},{"no":8,"title":"顿渐品第八","note":"","paras":67,"translated":67},{"no":9,"title":"护法品第九","note":"","paras":20,"translated":20},{"no":10,"title":"付嘱品第十","note":"","paras":98,"translated":98}]},{"id":"lengqie","title":"楞伽阿跋多罗宝经","shortTitle":"楞伽经","sanskrit":"Laṅkāvatāra Sūtra","dynasty":"刘宋","translator":"求那跋陀罗 译","era":"公元 443 年","desc":"禅门开山之典。达磨西来，以此经四卷印心；四卷记佛在楞伽山答大慧菩萨百八问，唱「诸法唯是自心所现」，说五法三自性、八识二无我。","quote":"世间离生灭，犹如虚空华；智不得有无，而兴大悲心。","accent":"#7e8a96","chapters":[{"no":1,"title":"一切佛语心品第一之一","note":"卷第一","paras":343,"translated":343},{"no":2,"title":"一切佛语心品之二","note":"卷第二","paras":235,"translated":235},{"no":3,"title":"一切佛语心品之三","note":"卷第三","paras":246,"translated":246},{"no":4,"title":"一切佛语心品之四","note":"卷第四","paras":276,"translated":276}]}]